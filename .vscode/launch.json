{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Core A53#0 + A53#1 + A53#2 Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/sw/hello_world_a53/build/hello_world_a53.elf",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerArgs": "-q",
            "targetArchitecture": "arm64",
            "customLaunchSetupCommands": [
                { "text": "set schedule-multiple off" },
                { "text": "set remotetimeout 20" },
                { "text": "file ${workspaceRoot}/sw/hello_world_a53/build/hello_world_a53.elf" },
                { "text": "target extended-remote localhost:3001" },
                { "text": "add-inferior" },
                { "text": "inferior 2" },
                { "text": "file ${workspaceRoot}/sw/hello_world_a53_1/build/hello_world_a53_1.elf" },
                { "text": "python gdb.execute('attach 2')" },
                { "text": "add-inferior" },
                { "text": "inferior 3" },
                { "text": "file ${workspaceRoot}/sw/hello_world_a53_2/build/hello_world_a53_2.elf" },
                { "text": "python gdb.execute('attach 3')" },
                { "text": "source ${workspaceRoot}/.vscode/a53_cores.gdb" },
                { "text": "inferior 1" }
            ],
            "launchCompleteCommand": "None"
        },
        {
            "name": "Core R5 Lockstep Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/sw/hello_world_r5/build/hello_world_r5.elf",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerArgs": "-q",
            "targetArchitecture": "arm",
            "customLaunchSetupCommands": [
                { "text": "set remotetimeout 20" },
                { "text": "file ${workspaceRoot}/sw/hello_world_r5/build/hello_world_r5.elf" },
                { "text": "target extended-remote localhost:3000" }
            ],
            "launchCompleteCommand": "None"
        },
        {
            "name": "QEMU All Cores Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/sw/hello_world_a53/build/hello_world_a53.elf",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerArgs": "-q",
            "targetArchitecture": "arm64",
            "customLaunchSetupCommands": [
                { "text": "file ${workspaceRoot}/sw/hello_world_a53/build/hello_world_a53.elf" },
                { "text": "add-symbol-file ${workspaceRoot}/sw/hello_world_a53_1/build/hello_world_a53_1.elf" },
                { "text": "add-symbol-file ${workspaceRoot}/sw/hello_world_a53_2/build/hello_world_a53_2.elf" },
                { "text": "target extended-remote localhost:1234" },
                { "text": "set schedule-multiple on" },
                { "text": "set scheduler-locking step" },
                { "text": "add-inferior" },
                { "text": "inferior 2" },
                { "text": "file ${workspaceRoot}/sw/hello_world_r5/build/hello_world_r5.elf" },
                { "text": "python gdb.execute('attach 2')" },
                { "text": "inferior 1" },
                { "text": "detach" },
                { "text": "python gdb.execute('attach 1')" }
            ],
            "launchCompleteCommand": "None"
        },
        {
            "name": "Rust: Core A53#0 + A53#1 + A53#2 Debug",
            "type": "gdb",
            "request": "attach",
            "target": "extended-remote localhost:3001",
            "executable": "${workspaceFolder}/sw/target/aarch64-unknown-none/debug/hello-world-a53-rs",
            "cwd": "${workspaceFolder}",
            "gdbpath": "${userHome}/.cargo/bin/rust-gdb",
            "env": {
                "RUST_GDB": "gdb-multiarch"
            },
            "stopAtConnect": true,
            "debugger_args": ["-iex", "set remotetimeout 20", "-iex", "python import gdb_load_rust_pretty_printers"],
            "autorun": [
                "set schedule-multiple off",
                "add-inferior",
                "inferior 2",
                "file ${workspaceFolder}/sw/target/aarch64-unknown-none/debug/hello-world-a53-1-rs",
                "python gdb.execute('attach 2')",
                "add-inferior",
                "inferior 3",
                "file ${workspaceFolder}/sw/target/aarch64-unknown-none/debug/hello-world-a53-2-rs",
                "python gdb.execute('attach 3')",
                "source ${workspaceFolder}/.vscode/a53_cores.gdb",
                "inferior 1"
            ]
        },
        {
            "name": "Rust: Core R5 Lockstep Debug",
            "type": "gdb",
            "request": "attach",
            "target": "extended-remote localhost:3000",
            "executable": "${workspaceFolder}/sw/target/armv7r-none-eabihf/debug/hello-world-r5-rs",
            "cwd": "${workspaceFolder}",
            "gdbpath": "${userHome}/.cargo/bin/rust-gdb",
            "env": {
                "RUST_GDB": "gdb-multiarch"
            },
            "stopAtConnect": true,
            "debugger_args": ["-iex", "set remotetimeout 20", "-iex", "python import gdb_load_rust_pretty_printers"]
        },
        {
            "name": "Rust: QEMU All Cores Debug",
            "type": "gdb",
            "request": "attach",
            "target": "extended-remote localhost:1234",
            "executable": "${workspaceFolder}/sw/target/aarch64-unknown-none/debug/hello-world-a53-rs",
            "cwd": "${workspaceFolder}",
            "gdbpath": "${userHome}/.cargo/bin/rust-gdb",
            "env": {
                "RUST_GDB": "gdb-multiarch"
            },
            "stopAtConnect": true,
            "debugger_args": ["-iex", "python import gdb_load_rust_pretty_printers"],
            "autorun": [
                "add-symbol-file ${workspaceFolder}/sw/target/aarch64-unknown-none/debug/hello-world-a53-1-rs",
                "add-symbol-file ${workspaceFolder}/sw/target/aarch64-unknown-none/debug/hello-world-a53-2-rs",
                "set schedule-multiple on",
                "set scheduler-locking step",
                "add-inferior",
                "inferior 2",
                "file ${workspaceFolder}/sw/target/armv7r-none-eabihf/debug/hello-world-r5-rs",
                "python gdb.execute('attach 2')",
                "inferior 1"
            ]
        }
    ],
    "compounds": [
        {
            "name": "All Cores Debug",
            "configurations": [
                "Core A53#0 + A53#1 + A53#2 Debug",
                "Core R5 Lockstep Debug"
            ],
            "stopAll": true
        },
        {
            "name": "Rust: All Cores Debug",
            "configurations": [
                "Rust: Core A53#0 + A53#1 + A53#2 Debug",
                "Rust: Core R5 Lockstep Debug"
            ],
            "stopAll": true
        }
    ]
}
